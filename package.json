{
  "name": "ironman-planner",
  "private": true,
  "version": "0.21.1",
  "type": "module",
  "description": "Offlinefähige Ironman-Trainings-App (PWA) mit wochenzielbasierter Planung",
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "dev": "vite",
    "dev:host": "vite --host",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "preview:host": "vite preview --host",
    "typecheck": "tsc -b --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "build:preview": "vite build --config tools/preview/vite.config.ts && node tools/preview/inline.mjs"
  },
  "dependencies": {
    "dexie": "^4.2.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.2.2",
    "@types/node": "^22.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.0.1",
    "fake-indexeddb": "^6.0.0",
    "tailwindcss": "^4.2.2",
    "typescript": "~6.0.3",
    "vite": "^8.1.0",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^4.1.4"
  }
}
